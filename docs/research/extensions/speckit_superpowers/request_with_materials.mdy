    ctx, span := tracer.Start(ctx, "nano-task-"+id)
    defer span.End()
    
    span.SetAttributes(
        attribute.String("task.id", id),
        attribute.Int("task.tokens", estimateTokens(id)),
    )
    // ... execution
}
