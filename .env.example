# .env.example — tracked template for the HelixConstitution repo itself.
# Copy to `.env` (GIT-IGNORED §11.4.30); PLACEHOLDERS ONLY (§11.4.10). chmod 600.
# This repo needs NO credentials of its own — only build/release/tooling knobs.

# ── Release / tag naming (§11.4.151) ────────────────────────────────────────
# Optional: pin this repo's release prefix. If unset, scripts/release_prefix.sh
# resolves the §11.4.29 fallback automatically: helix_constitution
# (lowercased snake_case of the "HelixConstitution" root dir name).
# HELIX_RELEASE_PREFIX=helix_constitution

# ── Action-prefix system (§11.4.140) — OPTIONAL ─────────────────────────────
# Defaults to actions/registry.yaml; override only to point elsewhere.
# HELIX_ACTION_REGISTRY=/abs/path/to/actions/registry.yaml

# ── Translation pipeline — OPTIONAL ─────────────────────────────────────────
# Override the machine-specific defaults baked into
# scripts/translation/translate-pipeline.sh (lines 39-40, a §11.4.28 smell).
# HELIX_TRANSLATE_BIN=/abs/path/to/unified-translator
# TRANSLATE_EVIDENCE_DIR=/abs/path/to/evidence/translate
